@page "/compra/getselectcomprar"
@using AppForSEII2526.Web.API
@inject AppForSEII2526APIClient apiclient
@inject ILogger<GetSelectComprar> logger
@inject ComprarStateContainer comprarStateContainer
@inject NavigationManager navigation

<h3>Selecciona herramientas para comprar</h3>
<div class="container-fluid">
    <div class="row alert alert-danger" role="alert" hidden="@esconderErrors">
        <p id="ErrorsShown">Errors: @errors</p>
    </div>
    <div class="row">
        <div class="col-8">
            <div class="row">
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Material</span>
                        <input type="text" id="inputMaterial" @bind=filtroMaterial class="form-control" placeholder="Material" aria-label="Material" aria-describedby="basic-addon1">
                    </div>
                    <div class="col">
                        <div class="input-group mb-3">
                            <span class="input-group-text" id="basic-addon1">Precio</span>
                            <input type="text" id="inputPrecio" @bind=filtroPrecio class="form-control" placeholder="Precio" aria-label="Precio" aria-describedby="basic-addon1">
                        </div>
                    </div>
                    <div class="col">
                        <div class="input-group mb-3">
                            <span class="input-group-text" id="basic-addon1">Nombre</span>
                            <input type="text" id="inputNombre" @bind=filtroNombre class="form-control" placeholder="Nombre" aria-label="Nombre" aria-describedby="basic-addon1">
                        </div>
                    </div>
                </div>
                <div class="col">
                    <button type="button" class="btn btn-primary" @onclick=@BuscarHerramientas id="buscarHerramientas">Buscar Herramientas</button>
                </div>
            </div>
            <div class="row">
                @if (herramientas == null)
                {
                    <p>Cargando herramientas....</p>
                }
                else
                {
                    <div class="mh-100 table-responsive">
                        <table class="table table-condensed table-hover" id="TablaHerramientas">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>Fabricante</th>
                                    <th>Material</th>
                                    <th>Precio</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var herramienta in herramientas)
                                {
                                    <tr id="HerramientaData_@herramienta.Id">
                                        <td>@herramienta.Nombre</td>
                                        <td>@herramienta.Fabricante</td>
                                        <td>@herramienta.Material</td>
                                        <td>@herramienta.Precio</td>
                                        <td>
                                            <button class="btn btn-outline-secondary" id="herramientaparacomprar_@herramienta.Nombre" @onclick="@(() => AddHerramienta(herramienta))">Añadir</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                }
            </div>
        </div>
        <div class="col-2" hidden="@esconderHerramientasCompradas">
            <div class="row">
                <h3>Carrito de la compra</h3>
            </div>
            @foreach (ComprarItemDTO item in compra.ComprarItem)
            {
                <div class="row">
                    <button type="button" class="btn btn-light" id="eliminarherramientas_@item.Nombre" @onclick="@(() => EliminarCompraItem(item))">x @item.Nombre - @item.Precio€</button>
                </div>
            }
            <div class="row">
                <button type="button" class="btn btn-primary" id="purchaseHerraminetaButton" @onclick=@HerramientasCompradas>Comprar herramientas</button>
            </div>
        </div>

    </div>

</div>

@code {
    private bool esconderHerramientasCompradas { get { return compra.ComprarItem.Count == 0; } }
    private ICollection<HerramientaComprarDTO> herramientas;
    private bool esconderErrors { get { return errors.Length == 0; } }
    private string errors = "";
    private double? filtroPrecio { get; set; }
    private string? filtroMaterial { get; set; }
    private string? filtroNombre { get; set; }
    private ComprarForCreateDTO compra => comprarStateContainer.Compra;

    private bool hiddenRentingCart = true;

    private void AddHerramienta(HerramientaComprarDTO herramienta)
    {
        comprarStateContainer.AddHerramienta(herramienta);
    }

    private void EliminarCompraItem(ComprarItemDTO item)
    {
        comprarStateContainer.EliminarHerramienta(item);
        if (compra.ComprarItem.Count == 0) hiddenRentingCart = true;
    }


    public async void BuscarHerramientas()
    {
        if (filtroPrecio == 0)
        {
            filtroPrecio = null;
        }
        try
        {
            herramientas = await apiclient.GetHerramientaComprarAsync(filtroMaterial, filtroPrecio, filtroNombre);
            errors = "";

        }
        catch (ApiException ex)
        {
            logger.LogError($"{DateTime.Now} Error: {ex}");
            errors = "Error mientras se conectaba al sistema";
        }
        StateHasChanged();
    }


    protected override Task OnInitializedAsync()
    {

        BuscarHerramientas();

        return base.OnInitializedAsync();
    }
    private void HerramientasCompradas()
    {
        navigation.NavigateTo("/compra/crearcompra");
    }

}