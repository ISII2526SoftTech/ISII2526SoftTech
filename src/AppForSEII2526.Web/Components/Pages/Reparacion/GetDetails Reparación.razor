@page "/reparacion/getdetailsreparacion"
@using AppForSEII2526.Web.API
@inject AppForSEII2526APIClient pruebaClient

<PageTitle>Detalle de Reparación</PageTitle>

<h3>Factura simplificada</h3>

@if (_reparacion == null)
{
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">@error</div>
    }
    else
    {
        <p>Introduce un ID para buscar los detalles de una reparación.</p>
    }
}
else
{
    
    <div class="card mb-4">
        <div class="card-header bg-light">
            <strong>Datos del Cliente y Reparación</strong>
        </div>
        <div class="card-body">
            <table class="table table-borderless table-sm">
                <tr>
                    <th style="width: 180px;">ID Reparación:</th>
                    <td>@_reparacion.Id</td>
                </tr>
                <tr>
                    <th>Cliente:</th>
                    <td>@_reparacion.NombreCliente @_reparacion.ApellidoCliente</td>
                </tr>
                <tr>
                    <th>Teléfono:</th>
                    <td>@_reparacion.NºTelefono</td>
                </tr>
                <tr>
                    <th>Fecha Entrega:</th>
                    <td>@_reparacion.FechaEntrega.ToString("dd/MM/yyyy")</td>
                </tr>
                <tr>
                    <th>Método Pago:</th>
                    <td>@_reparacion.MetodoPago</td>
                </tr>
            </table>
        </div>
    </div>

    
    <h4>Detalle de conceptos</h4>
    <table class="table table-striped table-hover mt-3 align-middle">
        <thead class="table-dark">
            <tr>
                <th scope="col">ID</th>
                <th scope="col">Herramienta</th>
                <th scope="col">Fabricante</th>
                <th scope="col">Descripción / Problema</th>

                <th scope="col" class="text-end">Precio Unit.</th>
                <th scope="col" class="text-center">Cant.</th>
                <th scope="col" class="text-end">Precio Total</th>
            </tr>
        </thead>
        <tbody>
            @if (_reparacion.ReparacionItem != null && _reparacion.ReparacionItem.Any())
            {
                
                double sumaVerificacion = 0;

                @foreach (var item in _reparacion.ReparacionItem)
                {
                    sumaVerificacion += item.PrecioTotal;

                    <tr>
                        <td>@item.IdHerramienta</td>
                        <td>@item.NombreHerramienta</td>
                        <td>@item.NombreFabricante</td>
                        <td>@item.Descripcion</td>

                        <td class="text-end">@item.PrecioUnitario.ToString("C")</td>
                        
                        <td class="text-center">@item.Cantidad</td>

                        <td class="text-end fw-bold">
                            @item.PrecioTotal.ToString("C")
                        </td>
                    </tr>
                }

                
                <tr class="table-secondary border-top border-dark">
                    <td colspan="6" class="text-end fw-bold text-uppercase fs-5">Total Reparación:</td>

                    
                    <td class="text-end fw-bold text-primary fs-4">
                        @sumaVerificacion.ToString("C")
                    </td>
                </tr>
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center">No hay herramientas registradas.</td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="container-fluid mt-5 pt-3 border-top">
    <div class="row">
        <div class="col-md-6">
            <h5>Buscar Otra Reparación</h5>
            <div class="input-group mb-3">
                <span class="input-group-text">ID</span>
                <input type="number" class="form-control" @bind="Id" placeholder="Ej. 1" />
                <button class="btn btn-primary" @onclick="CargarReparacion">Buscar</button>
            </div>
        </div>
    </div>
</div>

@code {
    
    private AppForSEII2526.Web.API.ReparacionDetailDTO _reparacion;
    private string error = "";
    private int? Id;

    private async Task CargarReparacion()
    {
        if (!Id.HasValue || Id.Value <= 0)
        {
            error = "ID inválido.";
            return;
        }

        try
        {
            _reparacion = await pruebaClient.GetMostrarReparacionPorIdAsync(Id.Value);
            error = "";
        }
        catch (AppForSEII2526.Web.API.ApiException ex)
        {
            if (ex.StatusCode == 404 || ex.StatusCode == 204) error = "Reparación no encontrada.";
            else error = $"Error API: {ex.Message}";
            _reparacion = null;
        }
        catch (Exception ex)
        {
            error = "Error de conexión.";
            Console.WriteLine(ex.Message);
            _reparacion = null;
        }
    }
}