@page "/reparacion/getselectreparacion"
@using AppForSEII2526.Web.API
@inject AppForSEII2526APIClient pruebaClient;
@inject NavigationManager navigation;

<PageTitle>Reparacion</PageTitle>

<h3>Select Tools For Offer</h3>
<div class="container-fluid">
    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @errors</p>
    </div>
    <div class="row">
        <div class="col-8">
            <div class="row">
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Nombre herramienta</span>
                        <input type="text" id="inputFabricante" @bind="nombreFiltro" class="form-control" placeholder="Fabricante" aria-label="Fabricante" aria-describedby="basic-addon1">
                    </div>
                </div>
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Tiempo reparación</span>
                        <input type="number" class="form-control" @bind="tiempoFiltro" id="precioMaxHerramienta" step="0.01" placeholder="Precio máximo">
                    </div>
                </div>
                <div class="col">
                    <button type="button" class="btn btn-primary" @onclick="FiltrarHerramientas" id="searchHerramientas">Buscar herramientas</button>
                </div>
            </div>
            <div class="row">
                @if (_herramientas == null)
                {
                    <p>Cargando herramientas...</p>
                }
                else
                {
                    <div class="mh-100 table-responsive">
                        <table class="table table-condensed table-hover" id="TableOfHerramientas">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>Fabricante</th>
                                    <th>Material</th>
                                    <th>Precio</th>
                                    <th>Añadir a oferta</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var herramienta in _herramientas)
                                {
                                    <tr id="HerramientaData_@herramienta.Id">
                                        <td>@herramienta.Nombre</td>
                                        <td>@herramienta.Fabricante?.Nombre</td>
                                        <td>@herramienta.Material</td>
                                        <td>@herramienta.Precio.ToString("C")</td>
                                        <td>
                                            <button class="btn btn-outline-secondary" id="herramientaToSelect_@herramienta.Id" @onclick="@(() => AddHerramienta(herramienta))">Añadir</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
        <div class="col-4" hidden="@hideOfertaCart">
            <div class="row">
                <h3>Items a ofertar</h3>
            </div>
            @foreach (var item in reparacionItems)
            {
                <div class="row">
                    <button type="button" class="btn btn-light" id="removeHerramienta_@item.IdHerramienta" @onclick="@(() => RemoveOfertaItem(item))">
                        x @item.IdHerramienta - @item.Precio.ToString("C")
                    </button>
                </div>
            }
            <div class="row">
                <button type="button" class="btn btn-primary" id="createOfertaButton" @onclick="CrearReparacion">Create Offer</button>
            </div>
        </div>
    </div>
</div>

@code {
    private ICollection<HerramientaDTO> _herramientas = new List<HerramientaDTO>();
    private List<ReparacionItemTemp> reparacionItems = new List<ReparacionItemTemp>();
    private bool hideOfertaCart { get { return reparacionItems.Count == 0; } }
    private bool hideErrors { get { return string.IsNullOrEmpty(errors); } }
    private string errors = "";
    private string nombreFiltro = "";
    private string tiempoFiltro = "";

    private class ReparacionItemTemp
    {
        public int IdHerramienta { get; set; }
        public string Descripcion { get; set; } = "";
        public int cantidad { get; set; }
        public float Precio { get; set; }
    };

    protected override async Task OnInitializedAsync()
    {
        await CargarHerramientas();
    }

    private async Task FiltrarHerramientas()
    {
        await CargarHerramientas();
    }

    private async Task CargarHerramientas()
    {
        try
        {
            _herramientas = await pruebaClient.GetSelectFiltradoReparacionAsync(nombreFiltro, tiempoFiltro);
            errors = "";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar herramientas: {ex.Message}");
            errors = "Error while connecting to the system";
            _herramientas = new List<HerramientaDTO>();
        }
        StateHasChanged();
    }

    private void AddHerramienta(HerramientaDTO herramienta)
    {
        if (!reparacionItems.Any(item => item.IdHerramienta == herramienta.Id))
        {
            reparacionItems.Add(new ReparacionItemTemp
            {
                IdHerramienta = herramienta.Id,
                
            });
        }
    }

    private void RemoveOfertaItem(ReparacionItemTemp item)
    {
        reparacionItems.Remove(item);
    }

    private void CrearReparacion()
    {
        navigation.NavigateTo("/oferta/createoferta");
    }
}