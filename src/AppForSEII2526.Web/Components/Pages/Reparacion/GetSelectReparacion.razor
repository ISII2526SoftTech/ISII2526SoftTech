@page "/reparacion/getselectreparacion"
@using AppForSEII2526.Web.API
@using AppForSEII2526.API.DTOs.ReparacionDTOs
@using AppForSEII2526.Web
@inject AppForSEII2526APIClient pruebaClient;
@inject NavigationManager navigation;
@inject ReparacionStateContainer reparacionState;

<PageTitle>Reparacion</PageTitle>

<h3>Seleccionar herramientas a reparar</h3>
<div class="container-fluid">
    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @errors</p>
    </div>

    <div class="row">
        <div class="@(hideReparacionCart ? "col-12" : "col-8")">
            @* --- FILTROS --- *@
            <div class="row">
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">NombreHerramienta</span>
                        <input type="text" id="inputNombreHerramienta" @bind="nombreFiltro" class="form-control" placeholder="Nombre" aria-label="Nombre" aria-describedby="basic-addon1">
                    </div>
                </div>
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">TiempoReparación</span>
                        <input type="text" id="tiempoReparacionInput" @bind="tiempoFiltro" class="form-control" placeholder="Tiempo reparación" aria-label="Nombre" aria-describedby="basic-addon1">
                    </div>
                </div>
                <div class="col">
                    <button type="button" class="btn btn-primary" @onclick="FiltrarHerramientas" id="searchHerramientas">BuscarHerramientas</button>
                </div>
            </div>

            @* --- TABLA --- *@
            <div class="row">
                @if (_herramientas == null)
                {
                    <p>Cargando herramientas...</p>
                }
                else
                {
                    <p>Herramientas encontradas: @_herramientas.Count</p>

                    <div class="mh-100 table-responsive">
                        <table class="table table-condensed table-hover" id="TableOfHerramientas">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>Fabricante</th>
                                    <th>Material</th>
                                    <th>Precio Unitario</th>
                                    <th>Tiempo reparación</th>
                                    <th>Añadir a reparación</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var herramienta in _herramientas)
                                {
                                    <tr id="HerramientaData_@herramienta.Nombre">
                                        <td>@herramienta.Nombre</td>
                                        <td>@herramienta.Fabricante.Nombre</td>
                                        <td>@herramienta.Material</td>                                       
                                        <td>@herramienta.Precio €</td>
                                        <td>@herramienta.TiempoReparacion</td>
                                        <td>
                                            <button class="btn btn-outline-secondary" id="herramientaForReparar_@herramienta.Nombre" @onclick="@(() => AddHerramienta(herramienta))">Añadir</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        @*CARRITO DE REPARACIÓN*@
        @if (!hideReparacionCart)
        {
            <div class="col-4">
                <div class="card sticky-top" style="top: 20px; z-index: 100;">
                    <div class="card-header bg-light">
                        <h4>Resumen Reparación</h4>
                        <p class="mb-0"><small>Items seleccionados: @reparacionState.Reparacion.ReparacionItem.Count</small></p>
                    </div>
                    <div class="card-body" style="max-height: 70vh; overflow-y: auto;">
                        @foreach (var item in reparacionState.Reparacion.ReparacionItem)
                        {
                            <div class="row mb-3 border-bottom pb-2">
                                <div class="col-12">
                                    <strong>@item.NombreHerramienta</strong>
                                    <button type="button" class="btn-close float-end" aria-label="Close"
                                            @onclick="@(() => RemoveReparacionItem(item))"></button>
                                </div>

                                <div class="col-12 mt-2 d-flex align-items-center justify-content-between">
                                    @* CANTIDAD *@
                                    <div class="input-group input-group-sm" style="max-width: 150px;">
                                        <span class="input-group-text">Cant.</span>
                                        <input type="number" class="form-control"
                                               value="@item.Cantidad"
                                               @onchange="@((ChangeEventArgs e) => UpdateCantidad(item, e.Value))"
                                               min="1" />
                                    </div>

                                    @* PRECIO TOTAL ITEM *@
                                    <div class="text-end">
                                        <small class="text-muted">Unit: @item.PrecioUnitario.ToString("C")</small><br />
                                        <strong class="text-primary">Total: @item.PrecioTotal.ToString("C")</strong>
                                    </div>
                                </div>
                                @* DESCRIPCIÓN OPCIONAL *@
                                <div class="col-12 mt-1">
                                    <input type="text" class="form-control form-control-sm"
                                           placeholder="Descripción de la avería..."
                                           value="@item.Descripcion"
                                           @onchange="@((ChangeEventArgs e) => UpdateDescripcion(item, e.Value?.ToString()))" />
                                </div>
                            </div>
                        }

                        <div class="d-grid gap-2 mt-3">
                            <div class="d-flex justify-content-between">
                                <strong>Total Estimado:</strong>
                                <strong>@reparacionState.Reparacion.ReparacionItem.Sum(i => i.PrecioTotal).ToString("C")</strong>
                            </div>

                            <button type="button" class="btn btn-success" id="createReparacionButton"
                                    @onclick="IrACrearReparacion"
                                    disabled="@(reparacionState.Reparacion.ReparacionItem.Count == 0)">
                                Continuar Reparación
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private ICollection<HerramientaDTO> _herramientas = new List<HerramientaDTO>();

    private bool hideErrors => string.IsNullOrEmpty(errors);
    private bool hideReparacionCart => reparacionState.Reparacion.ReparacionItem == null || reparacionState.Reparacion.ReparacionItem.Count == 0;

    private string errors = "";
    private string nombreFiltro = "";
    private string tiempoFiltro = "";

    protected override async Task OnInitializedAsync()
    {
        reparacionState.OnChange += StateHasChanged;
        await CargarHerramientas();
    }

    public void Dispose()
    {
        reparacionState.OnChange -= StateHasChanged;
    }

    private async Task FiltrarHerramientas()
    {
        await CargarHerramientas();
    }

    private async Task CargarHerramientas()
    {
        try
        {
            _herramientas = await pruebaClient.GetSelectFiltradoReparacionAsync(nombreFiltro, tiempoFiltro);
            errors = "";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar herramientas: {ex.Message}");
            errors = "Error while connecting to the system";
            _herramientas = new List<HerramientaDTO>();
        }
        StateHasChanged();
    }

    private bool IsHerramientaInList(int id)
    {
        return reparacionState.Reparacion.ReparacionItem.Any(i => i.IdHerramienta == id);
    }

    private void AddHerramienta(HerramientaDTO herramienta)
    {
        if (!IsHerramientaInList(herramienta.Id))
        {
            var newItem = new ReparacionItemDTO();
            newItem.IdHerramienta = herramienta.Id;
            newItem.NombreHerramienta = herramienta.Nombre;
            newItem.PrecioUnitario = (float)herramienta.Precio;
            newItem.NombreFabricante = herramienta.Fabricante.Nombre;
            newItem.TiempoReparacion = herramienta.TiempoReparacion;
            newItem.Cantidad = 1;
            newItem.PrecioTotal = (float)newItem.PrecioUnitario * newItem.Cantidad;
            newItem.Descripcion = "";

            reparacionState.AddReparacionItem(newItem);
        }
    }

    private void RemoveReparacionItem(ReparacionItemDTO item)
    {
        reparacionState.RemoveReparacionItem(item);
    }

    private void UpdateCantidad(ReparacionItemDTO item, object value)
    {
        if (int.TryParse(value?.ToString(), out int nuevaCantidad))
        {
            item.Cantidad = nuevaCantidad;
            item.PrecioTotal = (float)item.PrecioUnitario * nuevaCantidad;
            StateHasChanged();
        }
    }

    private void UpdateDescripcion(ReparacionItemDTO item, string desc)
    {
        item.Descripcion = desc;
    }

    private void IrACrearReparacion()
    {
        if (reparacionState.Reparacion.ReparacionItem.Count > 0)
        {
            navigation.NavigateTo("/reparacion/createreparacion");
        }
    }
}