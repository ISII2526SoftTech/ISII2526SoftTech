@page "/oferta/getselectoferta"
@using AppForSEII2526.Web.API
@inject AppForSEII2526APIClient pruebaClient;

<PageTitle>Oferta</PageTitle>

<h1>GetSelectOferta</h1>

Welcome to your new app.

<br>
<br>

<h3>Herramientas Disponibles</h3>

<div class="container-fluid">
    <div class="row">
        <p></p>
        <h5>Filtrar Herramientas</h5>
        <div class="input-group">
            <div class="input-group-prepend">
                <span class="input-group-text">Nombre</span>
            </div>
            <input type="text" class="form-control" @bind="fabricanteFiltro" id="fabricanteHerramienta">
            <div class="input-group-prepend">
                <span class="input-group-text">Precio Máximo</span>
            </div>
            <input type="number" class="form-control" @bind="precioMaxFiltro" id="precioMaxHerramienta" step="0.01">
            <div class="input-group-append">
                <button class="btn btn-outline-primary" id="searchHerramientas" @onclick="@FiltrarHerramientas">Buscar herramientas</button>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between">
        <div class="container-fluid">
            @if (_herramientas.Count == 0)
            {
                <p><em>No se encontraron herramientas</em></p>
            }
            else
            {
                <div class="mh-100 table-responsive">
                    <table class="table table-condensed table-hover" id="TableOfHerramientas">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Fabricante</th>
                                <th>Material</th>
                                <th>Precio</th>
                                <th>Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var herramienta in _herramientas)
                            {
                                <tr id="HerramientaData_@herramienta.Id">
                                    <td>@herramienta.Nombre</td>
                                    <td>@herramienta.Fabricante?.Nombre</td>
                                    <td>@herramienta.Material</td>
                                    <td>@herramienta.Precio.ToString("C")</td>
                                    <td>
                                        <button class="btn btn-outline-secondary" id="herramientaToSelect_@herramienta.Id" @onclick="@(() => SeleccionarHerramienta(herramienta))">Seleccionar</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private ICollection<HerramientaDTO> _herramientas = new List<HerramientaDTO>();

    private string fabricanteFiltro = "";
    private double? precioMaxFiltro;
    protected override async Task OnInitializedAsync()
    {
        await CargarHerramientas();
    }

    private async Task FiltrarHerramientas()
    {
        await CargarHerramientas();
    }
    private async Task CargarHerramientas()
    {
        try
        {
            _herramientas = await pruebaClient.GetSelectFiltradoOfertaAsync(fabricanteFiltro, precioMaxFiltro);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar herramientas {ex.Message}");
            _herramientas = new List<HerramientaDTO>();
        }
        StateHasChanged();
    }
    private void SeleccionarHerramienta(HerramientaDTO herramienta)
    {
        Console.WriteLine($"Herramienta seleccionada {herramienta.Nombre}");
    }
}