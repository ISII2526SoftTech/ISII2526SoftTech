@page "/oferta/getdetailsferta"
@using AppForSEII2526.Web.API
@inject AppForSEII2526APIClient pruebaClient;

<PageTitle>Oferta</PageTitle>

<h1>GetDetailsOferta</h1>

Welcome to your new app.

<br>
<br>


<div class="container-fluid">
    <div class="row">
        <p></p>
        <h5>Filtrar Oferta por Id</h5>
        <div class="input-group">
            <div class="input-group-prepend">
                <span class="input-group-text">ID</span>
            </div>
            <input type="number" class="form-control" @bind="Id" id="IdOferta" step="0.01">
            <div class="input-group-append">
                <button class="btn btn-outline-primary" id="searchHerramientas" @onclick="@FiltrarOfertas">Buscar ofertas</button>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between">
        <div class="container-fluid">
            @if (_oferta == null)
            {
                <p><em>No se encontraron ofertas</em></p>
            }
            else
            {
                <div class="mh-100 table-responsive">
                    <table class="table table-condensed table-hover" id="TableOfHerramientas">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Inicio</th>
                                <th>Final</th>
                                <th>Metodo de pago</th>
                                <th>Dirigido a...</th>
                            </tr>
                        </thead>
                        <tbody>
                            
                                <tr id="OfertaData_@_oferta.Id">
                                    <td>@_oferta.Id</td>
                                    <td>@_oferta.FechaInicio</td>
                                    <td>@_oferta.FechaFinal</td>
                                    <td>@_oferta.MetodoPago</td>
                                    <td>@_oferta.DirigidaA</td>
                                    <td>
                                        <button class="btn btn-outline-secondary" id="herramientaToSelect_@_oferta.Id" @onclick="@(() => SeleccionarOferta(_oferta))">Seleccionar</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private OfertaDetailDTO _oferta = new OfertaDetailDTO();

    private int? Id;
    protected override async Task OnInitializedAsync()
    {
        await CargarOfertas();
    }

    private async Task FiltrarOfertas()
    {
        await CargarOfertas();
    }
    private async Task CargarOfertas()
    {
        try
        {
            _oferta = await pruebaClient.GetOfertaDetallePorIdAsync(Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar oferta {ex.Message}");
            _oferta = new OfertaDetailDTO();
        }
        StateHasChanged();
    }
    private void SeleccionarOferta(OfertaDetailDTO oferta)
    {
        Console.WriteLine($"Oferta seleccionada {oferta.Id}");
    }
}